<Window x:Class="PixelLift.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelLift AI" Icon="PixelLift.ico" Width="1280" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragged"
        Background="#F3F6FA" FontFamily="Segoe UI, Yu Gothic UI" FontSize="13" Closing="WindowClosing" Closed="WindowClosed">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#344359"/>
            <Setter Property="Margin" Value="0,15,0,6"/>
        </Style>
        <Style x:Key="SmallNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#47566A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="58"/>
        </Grid.RowDefinitions>

        <Border Background="#15263B">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0">
                <Image Source="PixelLift.ico" Width="36" Height="36" Margin="0,0,10,0"/>
                <TextBlock Text="PixelLift AI" Foreground="White" FontWeight="SemiBold" FontSize="24"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="288"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#DAE2ED" BorderThickness="0,0,1,0" Background="White">
                <DockPanel Margin="14,18">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="画像" FontSize="16" FontWeight="SemiBold" Foreground="#15263B" Margin="0,0,0,10"/>
                        <Button Content="画像を追加…" Click="AddFilesClicked" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Content="選択画像を削除" Click="RemoveClicked" x:Name="RemoveButton" Margin="0,8,0,0"/>
                    <ListBox x:Name="FileList" SelectionChanged="SelectionChanged" Margin="0,10,0,0"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,5">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#4B5B70" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Background="#182535">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="15,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="プレビュー" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox DockPanel.Dock="Right" x:Name="Zoom" Width="106" VerticalAlignment="Center" SelectionChanged="ZoomChanged" AutomationProperties.Name="表示倍率"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              SizeChanged="PreviewResized" Background="#101B28" Padding="10">
                    <Grid x:Name="PreviewFrame" HorizontalAlignment="Center" VerticalAlignment="Center" Width="0" Height="0" ClipToBounds="True">
                        <Image x:Name="BeforeImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image x:Name="AfterImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Canvas IsHitTestVisible="False">
                            <Border x:Name="Divider" Background="#ECFFFF" Width="2" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="1" x:Name="EmptyPreview" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="24">
                    <TextBlock Text="ここに画像をドロップ" Foreground="#E7EDF6" FontSize="22" TextAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text="PNG、JPEG、TIFF、WebP" Foreground="#A4B7CC" Margin="0,8,0,0" TextAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="2" x:Name="CompareControls" Margin="15,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="処理前" Foreground="White" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="Split" Minimum="0" Maximum="1" Value="0.5" VerticalAlignment="Center" Margin="14,0"
                            ValueChanged="SplitChanged" AutomationProperties.Name="処理前と処理後の境界"/>
                    <TextBlock Grid.Column="2" Text="処理後" Foreground="White" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Border Grid.Column="2" BorderBrush="#DAE2ED" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="処理設定" FontSize="16" FontWeight="SemiBold" Foreground="#15263B"/>
                        <TextBlock Text="プロバイダー" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="Provider" SelectionChanged="SettingsChanged" AutomationProperties.Name="プロバイダー"/>
                        <TextBlock x:Name="ProviderNote" Style="{StaticResource SmallNote}" Margin="0,6,0,0"/>
                        <StackPanel x:Name="CloudSettings" Visibility="Collapsed">
                            <CheckBox x:Name="Enhance" Content="顔を補正（GFPGAN）" Checked="SettingsChanged" Unchecked="SettingsChanged" Margin="0,10,0,0"/>
                            <Button Content="API キーを設定…" Click="TokenClicked" Margin="0,7,0,0"/>
                            <TextBlock Style="{StaticResource SmallNote}" Margin="0,5,0,0">
                                <Hyperlink Click="BillingClicked">Replicate の請求設定</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="倍率" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="Scale" SelectionChanged="SettingsChanged" AutomationProperties.Name="倍率"/>
                        <TextBlock Text="書き出し形式" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="Format" SelectionChanged="SettingsChanged" AutomationProperties.Name="書き出し形式"/>
                        <StackPanel x:Name="JpegOptions" Visibility="Collapsed">
                            <TextBlock x:Name="QualityText" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="JpegQuality" Minimum="5" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="SettingsChanged" AutomationProperties.Name="JPEG 品質"/>
                        </StackPanel>
                        <Button Content="保存先を選択…" Click="FolderClicked" Margin="0,12,0,3"/>
                        <TextBlock x:Name="FolderText" Style="{StaticResource SmallNote}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <Separator Margin="0,16,0,12"/>
                        <TextBlock x:Name="SelectionInfo" Style="{StaticResource SmallNote}" />
                        <TextBlock x:Name="SelectionError" TextWrapping="Wrap" Foreground="#9C2626" Margin="0,4,0,0"/>
                        <Button x:Name="ProcessSelectedButton" Content="選択画像を処理" Click="ProcessSelectedClicked" Margin="0,9,0,0"/>
                        <Button x:Name="SaveSelectedButton" Content="選択した結果を保存…" Click="SaveSelectedClicked" Margin="0,6,0,0"/>
                        <Button x:Name="ClearButton" Content="キャッシュを削除…" Click="ClearClicked" Margin="0,6,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#DAE2ED" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLine" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#344359"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="キャンセル" Click="CancelClicked" Margin="8,0,0,0"/>
                    <Button x:Name="SaveAllButton" Content="すべての結果を保存…" Click="SaveAllClicked" Margin="8,0,0,0"/>
                    <Button x:Name="ProcessAllButton" Content="一括処理を開始" Click="ProcessAllClicked" Margin="8,0,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
