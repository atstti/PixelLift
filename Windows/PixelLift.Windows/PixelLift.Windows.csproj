<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PixelLift</AssemblyName>
    <ApplicationIcon>PixelLift.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>PixelLift AI</AssemblyTitle>
    <Product>PixelLift AI</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <Resource Include="PixelLift.ico" />
  </ItemGroup>
</Project>
